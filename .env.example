# Port for the Express API server
PORT=3333

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ichgram_db

# Secret used to sign JWT tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Public URL of the app, used in password reset links
APP_URL=http://localhost:8080

# SMTP server used to send password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
